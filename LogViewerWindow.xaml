<Window x:Class="BatchBaker.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktivitetslog" Height="450" Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView x:Name="LogListView" Grid.Row="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Tidspunkt" Width="150" DisplayMemberBinding="{Binding Timestamp}"/>
                    <GridViewColumn Header="Handling" Width="150" DisplayMemberBinding="{Binding Action}"/>
                    <GridViewColumn Header="Detaljer" Width="340" DisplayMemberBinding="{Binding Details}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CloseButton" Content="Luk" Width="80" Height="28" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
