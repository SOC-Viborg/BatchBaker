<Window x:Class="BatchBaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BatchBaker"
        mc:Ignorable="d"
        Title="BatchBaker" Height="600" Width="1150" MinHeight="350" MinWidth="700">
    <Window.Resources>
        <local:BoolToStatusConverter x:Key="BoolToStatusConverter"/>

        <!-- The batch being worked on: editable, with validation status and passwords. -->
        <GridView x:Key="BatchGridView">
            <GridViewColumn Header="Status" Width="70" DisplayMemberBinding="{Binding Path=ImportSuccess, Converter={StaticResource BoolToStatusConverter}}"/>
            <GridViewColumn Header="Årsag" Width="180" DisplayMemberBinding="{Binding Path=ImportError}"/>
            <GridViewColumn Header="Fornavn" DisplayMemberBinding="{Binding Path=FirstName}"/>
            <GridViewColumn Header="Efternavn" DisplayMemberBinding="{Binding Path=LastName}"/>
            <GridViewColumn Header="Brugernavn" DisplayMemberBinding="{Binding Path=Username}"/>
            <GridViewColumn Header="E-mail" DisplayMemberBinding="{Binding Path=Email}"/>
            <GridViewColumn Header="Afdeling" DisplayMemberBinding="{Binding Path=Department}"/>
            <GridViewColumn Header="Land" DisplayMemberBinding="{Binding Path=Country}"/>
            <GridViewColumn Header="Telefonnummer" DisplayMemberBinding="{Binding Path=PhoneNumber}"/>
            <GridViewColumn Header="Midlertidig adgangskode" DisplayMemberBinding="{Binding Path=TemporaryPassword}"/>
        </GridView>

        <!-- Saved or Active Directory users: read-only, no passwords. -->
        <GridView x:Key="OverviewGridView">
            <GridViewColumn Header="Status" Width="110" DisplayMemberBinding="{Binding Path=Status}"/>
            <GridViewColumn Header="Fornavn" DisplayMemberBinding="{Binding Path=FirstName}"/>
            <GridViewColumn Header="Efternavn" DisplayMemberBinding="{Binding Path=LastName}"/>
            <GridViewColumn Header="Brugernavn" DisplayMemberBinding="{Binding Path=Username}"/>
            <GridViewColumn Header="E-mail" DisplayMemberBinding="{Binding Path=Email}"/>
            <GridViewColumn Header="Afdeling" DisplayMemberBinding="{Binding Path=Department}"/>
            <GridViewColumn Header="Land" DisplayMemberBinding="{Binding Path=Country}"/>
            <GridViewColumn Header="Telefonnummer" DisplayMemberBinding="{Binding Path=PhoneNumber}"/>
            <GridViewColumn Header="Oprettet" DisplayMemberBinding="{Binding Path=Created}"/>
        </GridView>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Filer">
                <MenuItem Header="_Importér" Click="ImportCSV_Click"/>
                <MenuItem Header="_Tilføj bruger" Click="OnAddPersonClicked"/>
                <MenuItem Header="_Gem" Click="OnSaveClicked"/>
                <Separator/>
                <MenuItem Header="_Afslut" Click="OnExitClicked"/>
            </MenuItem>
            <MenuItem Header="_Administrér">
                <MenuItem Header="Åbn _PDF-mappe" Click="OnOpenPdfFolderClicked"/>
                <MenuItem Header="Åbn _datamappe" Click="OnOpenDataFolderClicked"/>
                <Separator/>
                <MenuItem Header="_Kontrollér domæne og OU'er" Click="OnCheckOusClicked"/>
            </MenuItem>
            <MenuItem Header="_Log" Click="OnViewLogsClicked"/>
            <MenuItem Header="_Hjælp">
                <MenuItem Header="_Om BatchBaker" Click="OnAboutClicked"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Navigator: which users to show, and which department to filter on. -->
            <DockPanel Grid.Column="0" Margin="6">
                <TextBlock DockPanel.Dock="Top" Text="Vis" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="ViewSelector" DockPanel.Dock="Top" Margin="0,0,0,6" SelectionChanged="ViewSelector_SelectionChanged">
                    <ComboBoxItem Content="Denne batch"/>
                    <ComboBoxItem Content="Oprettet med BatchBaker"/>
                    <ComboBoxItem Content="Active Directory"/>
                </ComboBox>
                <Button x:Name="RefreshButton" DockPanel.Dock="Bottom" Content="Opdatér" Margin="0,6,0,0" Padding="0,3" Visibility="Collapsed" Click="RefreshButton_Click"/>
                <TreeView x:Name="DepartmentTree" SelectedItemChanged="DepartmentTree_SelectedItemChanged"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <ListView x:Name="ListViewPeople" Grid.Column="2" MouseDoubleClick="ListViewPeople_MouseDoubleClick"/>
        </Grid>
    </DockPanel>
</Window>
